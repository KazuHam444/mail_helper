# 从 Microsoft Entra 应用注册的“概述”复制；不是邮箱密码，不需要 client secret
MS_CLIENT_ID=
MS_ACCOUNT=yourname@hotmail.com

# 默认只检查收件箱，包含 Focused/Other（重点/其他）、已读和未读
# 如需检查被误分到垃圾箱的通知，可设 inbox,junkemail；建议搭配发件人白名单
MAIL_FOLDERS=inbox
INITIAL_LOOKBACK_DAYS=7
DAILY_DIGEST_TIME=20:00
DESKTOP_NOTIFY=true

# 留空则完全本地规则运行。配置后候选邮件正文片段会发往该服务。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MIN_CONFIDENCE=0.80
# 阿里千问：填写此项即可启用，默认北京接口和 qwen-plus；无需重复填 AI_API_KEY
# 显式配置：AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1，AI_MODEL=qwen-plus
# 新加坡等其他地域的 key 需填写同地域地址，参考 README
DASHSCOPE_API_KEY=

# 可填邮箱或域名，多个用英文逗号分隔；白名单仍须有具体招聘行动
ALLOW_SENDERS=
BLOCK_SENDERS=

# 可选 Telegram 手机推送；网络需能访问 api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
