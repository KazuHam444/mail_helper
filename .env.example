# QQ 邮箱地址，以及在 QQ 邮箱设置里生成的「授权码」（不是 QQ 登录密码）
QQ_EMAIL=yourname@qq.com
QQ_AUTH_CODE=

# 可选；默认即为 QQ 邮箱 IMAP
IMAP_HOST=imap.qq.com
IMAP_PORT=993

# 默认只检查收件箱。可改为 INBOX,Junk；垃圾箱更需核实来源
MAIL_FOLDERS=INBOX
INITIAL_LOOKBACK_DAYS=7
DAILY_DIGEST_TIME=20:00
# 北京时间该时刻之后，把「昨天」的招聘待办再催一次（桌面/Telegram），每天仅一次
CATCHUP_DIGEST_TIME=12:30
DESKTOP_NOTIFY=true

# 若 Outlook/Hotmail 转发后 From 变成你的微软邮箱，把它填在这里（逗号分隔），便于还原正文里的原始 HR 发件人
FORWARD_SENDERS=

# 留空则完全本地规则运行。配置后候选邮件正文片段会发往该服务。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# AI 判 false 时，置信度达到该值才静默；更低则仍提醒（宁可错报）
AI_REJECT_CONFIDENCE=0.85
# 阿里千问：填写此项即可启用，默认北京接口和 qwen-plus；无需重复填 AI_API_KEY
# 显式配置：AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1，AI_MODEL=qwen-plus
# 新加坡等其他地域的 key 需填写同地域地址，参考 README
DASHSCOPE_API_KEY=

# 可填邮箱或域名，多个用英文逗号分隔；白名单仍须有具体招聘行动
ALLOW_SENDERS=
BLOCK_SENDERS=

# 摘要邮件：20:00 日报与 12:30 昨日催促会发到这些地址（逗号分隔，可发给自己或别人）
# 使用上面的 QQ_EMAIL + QQ_AUTH_CODE 经 smtp.qq.com 发送；即时单封提醒默认不发邮件
EMAIL_TO=
# EMAIL_INCLUDE_ALERTS=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465

# 可选 Telegram 手机推送；网络需能访问 api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
